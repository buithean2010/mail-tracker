# Microsoft Entra ID (Confidential Client — Authorization Code + PKCE)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost/auth/callback

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mailtracker
DB_USER=mailtracker
DB_PASSWORD=changeme

# Security
AES_KEY=          # 32-byte hex: openssl rand -hex 32
SESSION_SECRET=   # random string: openssl rand -base64 32

# App
APP_ENV=development
BASE_URL=http://localhost
SYNC_INTERVAL_MINUTES=30
